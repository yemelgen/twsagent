# Ignore Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Ignore installer logs
pip-log.txt
pip-delete-this-directory.txt

# Ignore Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Ignore PyBuilder
.pybuilder/
target/


# Ignore unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
cover/

# Ignore Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Ignore SageMath parsed files
*.sage.py

# Ignore Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Ignore Cython debug symbols
cython_debug/

# Ignore C extensions
*.so

# Ignore MacOS system files
.DS_Store

# Ignore Jetbrains settings
.idea/

# Ignore IB API files
ibapi/
